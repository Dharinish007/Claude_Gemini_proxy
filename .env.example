# Your Gemini API key (https://aistudio.google.com/apikey)
GEMINI_API_KEY=your-key-here

# Which Gemini model to route every request to.
# Check https://ai.google.dev/gemini-api/docs/models for current names.
GEMINI_MODEL=gemini-2.5-flash

# Port the proxy listens on. Point Claude Code at it with:
#   ANTHROPIC_BASE_URL=http://localhost:8787
PORT=8787
